# Public base URL used for absolute Open Graph / canonical URLs (set on the host).
NEXT_PUBLIC_SITE_URL=https://gymbro.example.com
# Leave unset (or anything but "true") while pre-release: emits noindex + robots.txt Disallow.
# NEXT_PUBLIC_ALLOW_INDEXING=true
# Optional: self-hosted exercise media base (defaults to the dataset's raw GitHub URL).
# NEXT_PUBLIC_EXERCISE_MEDIA_BASE=
